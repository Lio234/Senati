@model app_compuware.Models.Categoria

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
        <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de las Categorías</h1>
<hr />

<div class="container">
    <div class="row mb-3">
        <!-- Eliminamos el botón de agregar que estaba fuera de la tabla -->
    </div>

    <br />

    <div class="row">
        <table id="tb_categoria" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(car => car.id_categoria)</th>
                    <th>@Html.DisplayNameFor(car => car.categoria)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- Las filas de categorías se cargarán dinámicamente -->
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para Agregar/Editar Categoría -->
<div class="modal" tabindex="-1" id="modalCategoria">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Nueva Categoría</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCategoria" method="post">
                    <div class="mb-3">
                        <label for="id_categoria" class="form-label">ID Categoría</label>
                        <input type="text" class="form-control" asp-for="id_categoria" required>
                    </div>
                    <div class="mb-3">
                        <label for="categoria" class="form-label">Nombre Categoría</label>
                        <input type="text" class="form-control" asp-for="categoria" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSave">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Confirmar Eliminación de Categoría -->
<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar esta categoría?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
        <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
        <script>
            $(document).ready(function () {
                // Inicializamos DataTables para la tabla de categorías
                $("#tb_categoria").DataTable({
                    "ajax": {
                        "url": "@Url.Action("Listar", "Categoria")",  // Reemplaza con tu acción que devuelva los datos
                        "type": "GET",
                        "dataType": "json"
                    },
                    "columns": [
                        { "data": "id_categoria" },
                        { "data": "categoria" },
                        {
                            "data": "id_categoria",
                            "render": function (data) {
                                return "<button class='btn btn-outline-success' type='button' onclick='AbrirRegistro(\"" + data + "\")'><i class='far fa-edit'></i> Editar</button>" +
                                    "<button class='btn btn-outline-danger' type='button' onclick='Eliminar(\"" + data + "\")'><i class='far fa-trash-alt'></i> Borrar</button>";
                            }
                        }
                    ],
                    "order": [[1, "asc"]],
                    dom: "Bfrtip",
                    buttons: [
                        {
                            text: "Registrar Categoría",  // Solo este botón se usa para abrir el modal de registro
                            attr: { class: "btn btn-outline-primary" },
                            action: function () {
                                AbrirRegistro("");  // Acción para abrir el modal vacío (agregar nueva categoría)
                            }
                        }
                    ]
                });
            });

            // Función para abrir el modal para agregar o editar una categoría
            function AbrirRegistro(id_categoria) {
                if (id_categoria != "") {
                    // Si la categoría existe, hacemos una solicitud para consultar los datos
                    jQuery.ajax({
                        url: "@Url.Action("Consultar", "Categoria")" + "?id_categoria=" + id_categoria,  // Acción para consultar una categoría
                        type: "GET",
                        dataType: "json",
                        success: function (data) {
                            if (data != null) {
                                $("#id_categoria").val(data.id_categoria).attr("readonly", true);  // Deshabilitamos el campo ID para edición
                                $("#categoria").val(data.categoria);
                            }
                        }
                    });

                    $(".modal-title").text("Editar Categoría");  // Cambiamos el título del modal
                    $("#btnSave").html("<i class='fas fa-save'></i> Guardar cambios");  // Cambiamos el texto del botón de guardar


                } else {
                    // Si es un nuevo registro, dejamos los campos vacíos
                    $("#id_categoria").attr("readonly", false);

                    $("#id_categoria").val("");
                    $("#categoria").val("");
                    $(".modal-title").text("Registrar Categoría");
                    $("#btnSave").html("<i class='fas fa-save'></i> Guardar datos");


                }
                $("#modalCategoria").modal("show");  // Mostramos el modal
            }

            // Función para guardar la categoría
            $("#btnSave").click(function () {
                let categoria = {
                    "id_categoria": $("#id_categoria").val(),
                    "categoria": $("#categoria").val()
                };

                $.ajax({
                    url: "@Url.Action("Grabar", "Categoria")",  // Acción para guardar los datos
                    type: "POST",
                    data: JSON.stringify(categoria),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.resultado) {
                            $("#tb_categoria").DataTable().ajax.reload();  // Recargamos la tabla de categorías
                            $("#modalCategoria").modal("hide");  // Cerramos el modal
                        } else {
                            alert("No se pudo guardar la información.");
                        }
                    },
                    error: function () {
                        alert("Error al guardar la información.");
                    }
                });
            });

            // Variable global para almacenar el id_categoria a eliminar
            let categoriaAEliminar = "";

            // Función para eliminar una categoría
            function Eliminar(id_categoria) {
                // Guardamos el id_categoria en la variable global
                categoriaAEliminar = id_categoria;

                // Mostramos el modal de confirmación
                $("#modalEliminar").modal("show");
            }

            // Función que se ejecuta cuando el usuario confirma la eliminación
            $("#btnEliminarConfirmado").click(function () {
                // Realizamos la solicitud AJAX para eliminar la categoría
                $.ajax({
                    url: "@Url.Action("Borrar", "Categoria")",  // Llamamos al método Borrar en el controlador
                    type: "POST",  // Cambiar de GET a POST
                    data: { id_categoria: categoriaAEliminar },  // Enviamos el id_categoria
                    success: function (data) {
                        if (data.resultado) {
                            // Si la eliminación fue exitosa, recargamos la tabla
                            $("#tb_categoria").DataTable().ajax.reload();
                            // Cerramos el modal de eliminación
                            $("#modalEliminar").modal("hide");
                        } else {
                            alert("No se pudo eliminar la categoría.");
                        }
                    },
                    error: function () {
                        alert("Error al eliminar la categoría.");
                    }
                });
            });
        </script>
}
