@model app_compuware.Models.Pedido

@{
    ViewData["Title"] = "Listado de Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
    <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de los Pedidos</h1>
<hr />

<div class="container">
    <div class="row mb-3">
    </div>

    <br />

    <div class="row">
        <table id="tb_pedido" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(pedido => pedido.id_pedido)</th>
                    <th>@Html.DisplayNameFor(pedido => pedido.fecha)</th>
                    <th>@Html.DisplayNameFor(pedido => pedido.total)</th>  <!-- Nuevo campo -->
                    <th>@Html.DisplayNameFor(model => model.id_cliente)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal para agregar/editar pedido -->
<div class="modal" tabindex="-1" id="modalPedido">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Nuevo Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formPedido" method="post">
                    <div class="mb-3">
                        <label for="id_pedido" class="form-label">ID Pedido</label>
                        <input type="text" class="form-control" asp-for="id_pedido" required>
                    </div>
                    <div class="mb-3">
                        <label for="fecha" class="form-label">Fecha</label>
                        <input type="date" class="form-control" asp-for="fecha" required>
                    </div>
                    <div class="mb-3">
                        <label for="total" class="form-label">Total</label>
                        <input type="number" class="form-control" asp-for="total" required>
                    </div>
                    <!-- Campo Cliente -->
                    <div class="mb-3">
                        <label for="id_cliente" class="form-label">Cliente</label>
                        <select class="form-control" id="id_cliente" name="id_cliente" required>
                            <option value="" disabled selected>Seleccione un cliente</option>
                            @foreach (var cliente in ViewBag.Clientes as List<app_compuware.Models.Cliente>)
                            {
                                <option value="@cliente.id_cliente">@cliente.nombre</option>
                            }
                        </select>


                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSave">Guardar</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="ExportarPDF" class="btn btn-primary">
    <i class="fas fa-file-pdf"></i> Exportar PDF
</a>
<a asp-action="ExportarExcel" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
</a>

<!-- Modal de confirmación de eliminación -->
<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar este pedido?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
    <script>
               $(document).ready(function () {
            inicializarTablaPedidos();

            // Inicializar tabla de pedidos
            function inicializarTablaPedidos() {
                $("#tb_pedido").DataTable({
                    "ajax": {
                        "url": "@Url.Action("Listar", "Pedido")",
                        "type": "GET",
                        "dataType": "json"
                    },
                    "columns": [
                        { "data": "id_pedido" },
                        { "data": "fecha" },
                        { "data": "total" },
                        { "data": "cliente" },  // Aquí usamos 'cliente' en vez de 'nombre_cliente'
                        {
                            "data": "id_pedido",
                            "render": function (data) {
                                return `
                                    <button class='btn btn-outline-success' onclick='AbrirRegistro("${data}")'><i class='far fa-edit'></i> Editar</button>
                                    <button class='btn btn-outline-danger' onclick='Eliminar("${data}")'><i class='far fa-trash-alt'></i> Borrar</button>`;
                            }
                        }
                    ],
                    "order": [[1, "asc"]],
                    dom: "Bfrtip",
                    buttons: [
                        {
                            text: "Registrar Pedido",
                            attr: { class: "btn btn-outline-primary" },
                            action: function () {
                                AbrirRegistro("");
                            }
                        }
                    ]
                });
            }

            // Función para abrir el modal de edición o registro (sin cambios)
            window.AbrirRegistro = function (id_pedido) {
                limpiarModal();

                if (id_pedido) {
                    cargarPedido(id_pedido);
                    $(".modal-title").text("Editar Pedido");
                    $("#btnSave").html("<i class='fas fa-save'></i> Guardar cambios");
                } else {
                    $(".modal-title").text("Registrar Pedido");
                    $("#btnSave").html("<i class='fas fa-save'></i> Guardar datos");
                }
                $("#modalPedido").modal("show");
            };

            // Limpiar campos del modal (sin cambios)
            function limpiarModal() {
                $("#id_pedido").attr("readonly", false).val("");
                $("#fecha").val("");
                $("#total").val("");
                $("#id_cliente").val("");
            }

        function cargarPedido(id_pedido) {
            $.ajax({
                url: "@Url.Action("Consultar", "Pedido")",
                type: "GET",
                data: { id_pedido },
                success: function (data) {
                    if (data) {
                        // Llenamos los campos del modal con los datos del pedido
                        $("#id_pedido").val(data.id_pedido).attr("readonly", true);
                        $("#fecha").val(data.fecha);
                        $("#total").val(data.total);
                        // Establecer el cliente seleccionado en el select
                        $("#id_cliente").val(data.id_cliente);
                    } else {
                        alert("Error: No se encontraron datos del pedido.");
                    }
                },
                error: function () {
                    alert("Error al cargar los datos del pedido.");
                }
            });
        }

            // Guardar pedido (sin cambios)
            $("#btnSave").click(function () {
                const pedido = {
                    id_pedido: $("#id_pedido").val(),
                    fecha: $("#fecha").val(),
                    total: $("#total").val(),
                    id_cliente: $("#id_cliente").val()
                };

                $.ajax({
                    url: "@Url.Action("Grabar", "Pedido")",
                    type: "POST",
                    data: JSON.stringify(pedido),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.resultado) {
                            $("#tb_pedido").DataTable().ajax.reload();
                            $("#modalPedido").modal("hide");
                        } else {
                            alert("No se pudo guardar la información.");
                        }
                    },
                    error: function () {
                        alert("Error al guardar la información.");
                    }
                });
            });

            // Eliminar pedido (sin cambios)
            let pedidoAEliminar = "";

            window.Eliminar = function (id_pedido) {
                pedidoAEliminar = id_pedido;
                $("#modalEliminar").modal("show");
            };

            $("#btnEliminarConfirmado").click(function () {
                $.ajax({
                    url: "@Url.Action("Borrar", "Pedido")",
                    type: "POST",
                    data: { id_pedido: pedidoAEliminar },
                    success: function (data) {
                        if (data.resultado) {
                            $("#tb_pedido").DataTable().ajax.reload();
                            $("#modalEliminar").modal("hide");
                        } else {
                            alert("No se pudo eliminar el pedido.");
                        }
                    },
                    error: function () {
                        alert("Error al eliminar el pedido.");
                    }
                });
            });
        });


    </script>
}

