@model app_compuware.Models.Cliente

@{
    ViewData["Title"] = "Listado de Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
    <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de los Clientes</h1>
<hr />

<div class="container">
    <div class="row mb-3">
    </div>

    <br />

    <div class="row">
        <table id="tb_cliente" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(client => client.id_cliente)</th>
                    <th>@Html.DisplayNameFor(client => client.nombre)</th>
                    <th>@Html.DisplayNameFor(client => client.ap_paterno)</th>
                    <th>@Html.DisplayNameFor(client => client.ap_materno)</th>  <!-- Nuevo campo -->
                    <th>@Html.DisplayNameFor(client => client.direccion)</th>  <!-- Nuevo campo -->
                    <th>@Html.DisplayNameFor(client => client.telefono)</th>
                    <th>@Html.DisplayNameFor(client => client.correo)</th>  <!-- Nuevo campo -->
                    <th>@Html.DisplayNameFor(model => model.id_distrito)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<!-- Modal para agregar/editar cliente -->
<div class="modal" tabindex="-1" id="modalCliente">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Nuevo Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCliente" method="post">
                    <div class="mb-3">
                        <label for="id_cliente" class="form-label">ID Cliente</label>
                        <input type="text" class="form-control" asp-for="id_cliente" required>
                    </div>
                    <div class="mb-3">
                        <label for="nombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" asp-for="nombre" required>
                    </div>
                    <div class="mb-3">
                        <label for="ap_paterno" class="form-label">Apellido Paterno</label>
                        <input type="text" class="form-control" asp-for="ap_paterno" required>
                    </div>
                    <div class="mb-3">
                        <label for="ap_materno" class="form-label">Apellido Materno</label> <!-- Nuevo campo -->
                        <input type="text" class="form-control" asp-for="ap_materno" required>
                    </div>
                    <div class="mb-3">
                        <label for="telefono" class="form-label">Teléfono</label>
                        <input type="text" class="form-control" asp-for="telefono" required>
                    </div>
                    <div class="mb-3">
                        <label for="correo" class="form-label">Correo Electrónico</label> <!-- Nuevo campo -->
                        <input type="email" class="form-control" asp-for="correo" required>
                    </div>
                    <div class="mb-3">
                        <label for="direccion" class="form-label">Dirección</label> <!-- Nuevo campo -->
                        <input type="text" class="form-control" asp-for="direccion" required>
                    </div>
                    <!-- Campo Distrito -->
                    <div class="mb-3">
                        <label for="id_distrito" class="form-label">Distrito</label>
                        <select class="form-control" id="id_distrito" name="id_distrito" required>
                            <option value="" disabled selected>Seleccione un distrito</option>
                            @foreach (var distrito in ViewBag.Distritos as List<app_compuware.Models.Distrito>)
                            {
                                <option value="@distrito.id_distrito">@distrito.distrito</option>
                            }
                        </select>


                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSave">Guardar</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="ExportarPDF" class="btn btn-primary">
    <i class="fas fa-file-pdf"></i> Exportar PDF
</a>
<a asp-action="ExportarExcel" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
</a>

<!-- Modal de confirmación de eliminación -->
<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar este cliente?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
    <script>
               $(document).ready(function () {
            inicializarTablaClientes();

            // Inicializar tabla de clientes
            function inicializarTablaClientes() {
                $("#tb_cliente").DataTable({
                    "ajax": {
                        "url": "@Url.Action("Listar", "Cliente")",
                        "type": "GET",
                        "dataType": "json"
                    },
                    "columns": [
                        { "data": "id_cliente" },
                        { "data": "nombre" },
                        { "data": "ap_paterno" },
                        { "data": "ap_materno" },
                        { "data": "direccion" },
                        { "data": "telefono" },
                        { "data": "correo" },
                        { "data": "distrito" },  // Aquí usamos 'distrito' en vez de 'nombre_distrito'
                        {
                            "data": "id_cliente",
                            "render": function (data) {
                                return `
                                    <button class='btn btn-outline-success' onclick='AbrirRegistro("${data}")'><i class='far fa-edit'></i> Editar</button>
                                    <button class='btn btn-outline-danger' onclick='Eliminar("${data}")'><i class='far fa-trash-alt'></i> Borrar</button>`;
                            }
                        }
                    ],
                    "order": [[1, "asc"]],
                    dom: "Bfrtip",
                    buttons: [
                        {
                            text: "Registrar Cliente",
                            attr: { class: "btn btn-outline-primary" },
                            action: function () {
                                AbrirRegistro("");
                            }
                        }
                    ]
                });
            }

            // Función para abrir el modal de edición o registro (sin cambios)
            window.AbrirRegistro = function (id_cliente) {
                limpiarModal();

                if (id_cliente) {
                    cargarCliente(id_cliente);
                    $(".modal-title").text("Editar Cliente");
                    $("#btnSave").html("<i class='fas fa-save'></i> Guardar cambios");
                } else {
                    $(".modal-title").text("Registrar Cliente");
                    $("#btnSave").html("<i class='fas fa-save'></i> Guardar datos");
                }
                $("#modalCliente").modal("show");
            };

            // Limpiar campos del modal (sin cambios)
            function limpiarModal() {
                $("#id_cliente").attr("readonly", false).val("");
                $("#nombre").val("");
                $("#ap_paterno").val("");
                $("#ap_materno").val("");
                $("#telefono").val("");
                $("#correo").val("");
                $("#direccion").val("");
                $("#id_distrito").val("");
            }

        function cargarCliente(id_cliente) {
            $.ajax({
                url: "@Url.Action("Consultar", "Cliente")",
                type: "GET",
                data: { id_cliente },
                success: function (data) {
                    if (data) {
                        // Llenamos los campos del modal con los datos del cliente
                        $("#id_cliente").val(data.id_cliente).attr("readonly", true);
                        $("#nombre").val(data.nombre);
                        $("#ap_paterno").val(data.ap_paterno);
                        $("#ap_materno").val(data.ap_materno);
                        $("#telefono").val(data.telefono);
                        $("#correo").val(data.correo);
                        $("#direccion").val(data.direccion);
                        // Establecer el distrito seleccionado en el select
                        $("#id_distrito").val(data.id_distrito);
                    } else {
                        alert("Error: No se encontraron datos del cliente.");
                    }
                },
                error: function () {
                    alert("Error al cargar los datos del cliente.");
                }
            });
        }

            // Guardar cliente (sin cambios)
            $("#btnSave").click(function () {
                const cliente = {
                    id_cliente: $("#id_cliente").val(),
                    nombre: $("#nombre").val(),
                    ap_paterno: $("#ap_paterno").val(),
                    ap_materno: $("#ap_materno").val(),
                    telefono: $("#telefono").val(),
                    correo: $("#correo").val(),
                    direccion: $("#direccion").val(),
                    id_distrito: $("#id_distrito").val()
                };

                $.ajax({
                    url: "@Url.Action("Grabar", "Cliente")",
                    type: "POST",
                    data: JSON.stringify(cliente),
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.resultado) {
                            $("#tb_cliente").DataTable().ajax.reload();
                            $("#modalCliente").modal("hide");
                        } else {
                            alert("No se pudo guardar la información.");
                        }
                    },
                    error: function () {
                        alert("Error al guardar la información.");
                    }
                });
            });

            // Eliminar cliente (sin cambios)
            let clienteAEliminar = "";

            window.Eliminar = function (id_cliente) {
                clienteAEliminar = id_cliente;
                $("#modalEliminar").modal("show");
            };

            $("#btnEliminarConfirmado").click(function () {
                $.ajax({
                    url: "@Url.Action("Borrar", "Cliente")",
                    type: "POST",
                    data: { id_cliente: clienteAEliminar },
                    success: function (data) {
                        if (data.resultado) {
                            $("#tb_cliente").DataTable().ajax.reload();
                            $("#modalEliminar").modal("hide");
                        } else {
                            alert("No se pudo eliminar el cliente.");
                        }
                    },
                    error: function () {
                        alert("Error al eliminar el cliente.");
                    }
                });
            });
        });


    </script>
}

