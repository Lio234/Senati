@model app_compuware.Models.Producto

@{
    ViewData["Title"] = "Listado de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
    <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de los Productos</h1>
<hr />

<div class="container">
    <div class="row mb-3">
    </div>

    <br />

    <div class="row">
        <table id="tb_producto" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(prod => prod.id_producto)</th>
                    <th>@Html.DisplayNameFor(prod => prod.producto)</th>
                    <th>@Html.DisplayNameFor(prod => prod.costo)</th>
                    <th>@Html.DisplayNameFor(prod => prod.ganancia)</th>
                    <th>@Html.DisplayNameFor(prod => prod.id_marca)</th>
                    <th>@Html.DisplayNameFor(prod => prod.id_categoria)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal para agregar/editar producto -->
<div class="modal" tabindex="-1" id="modalProducto">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formProducto" method="post">
                    <div class="mb-3">
                        <label for="id_producto" class="form-label">ID Producto</label>
                        <input type="text" class="form-control" id="id_producto" required readonly>
                    </div>
                    <div class="mb-3">
                        <label for="producto" class="form-label">Nombre del Producto</label>
                        <input type="text" class="form-control" id="producto" required>
                    </div>
                    <div class="mb-3">
                        <label for="costo" class="form-label">Costo</label>
                        <input type="number" step="0.01" class="form-control" id="costo" required>
                    </div>
                    <div class="mb-3">
                        <label for="ganancia" class="form-label">Ganancia</label>
                        <input type="number" step="0.01" class="form-control" id="ganancia" required>
                    </div>
                    <div class="mb-3">
                        <label for="id_marca" class="form-label">Marca</label>
                        <select class="form-control" id="id_marca" required>
                            <option value="" disabled selected>Seleccione una marca</option>
                            @foreach (var marca in ViewBag.Marcas as List<app_compuware.Models.Marca>)
                            {
                                <option value="@marca.id_marca">@marca.marca</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="id_categoria" class="form-label">Categoría</label>
                        <select class="form-control" id="id_categoria" required>
                            <option value="" disabled selected>Seleccione una categoría</option>
                            @foreach (var categoria in ViewBag.Categorias as List<app_compuware.Models.Categoria>)
                            {
                                <option value="@categoria.id_categoria">@categoria.categoria</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSaveProducto">Guardar</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="ExportarPDF" class="btn btn-primary">
    <i class="fas fa-file-pdf"></i> Exportar PDF
</a>
<a asp-action="ExportarExcel" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
</a>

<!-- Modal de confirmación de eliminación -->
<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar este producto?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
    <script>
        $(document).ready(function () {
            inicializarTablaProductos();

            // Inicializar tabla de productos
            function inicializarTablaProductos() {
                $("#tb_producto").DataTable({
                    "ajax": {
                        "url": "@Url.Action("Listar", "Producto")",
                        "type": "GET",
                        "dataType": "json"
                    },
                    "columns": [
                        { "data": "id_producto" },
                        { "data": "producto" },
                        { "data": "costo" },
                        { "data": "ganancia" },
                        { "data": "marca" },
                        { "data": "categoria" },
                        {
                            "data": "id_producto",
                            "render": function (data) {
                                return `
                                    <button class='btn btn-outline-success' onclick='AbrirRegistro("${data}")'><i class='far fa-edit'></i> Editar</button>
                                    <button class='btn btn-outline-danger' onclick='Eliminar("${data}")'><i class='far fa-trash-alt'></i> Borrar</button>`;
                            }
                        }
                    ],
                    "order": [[1, "asc"]],
                    dom: "Bfrtip",
                    buttons: [
                        {
                            text: "Registrar Producto",
                            attr: { class: "btn btn-outline-primary" },
                            action: function () {
                                AbrirRegistro("");
                            }
                        }
                    ]
                });
            }

            // Función para abrir el modal de edición o registro
            window.AbrirRegistro = function (id_producto) {
                limpiarModal();

                if (id_producto) {
                    cargarProducto(id_producto);
                    $(".modal-title").text("Editar Producto");
                    $("#btnSaveProducto").html("<i class='fas fa-save'></i> Guardar cambios");
                } else {
                    $(".modal-title").text("Registrar Producto");
                    $("#btnSaveProducto").html("<i class='fas fa-save'></i> Guardar datos");
                }
                $("#modalProducto").modal("show");
            };

            // Limpiar campos del modal
            function limpiarModal() {
                $("#id_producto").attr("readonly", false).val("");
                $("#producto").val("");
                $("#costo").val("");
                $("#ganancia").val("");
                $("#marca").val("");
                $("#categoria").val("");
            }

        function cargarProducto(id_producto) {
            $.ajax({
                url: "@Url.Action("Consultar", "Producto")",
           type: "GET",
           data: { id_producto },
        success: function(data) {
                if (data && !data.Error)
                {
                // Llenar el modal con los datos del producto
                $("#id_producto").val(data.id_producto);
                $("#producto").val(data.producto);
                $("#costo").val(data.costo);
                $("#ganancia").val(data.ganancia);
                $("#id_marca").val(data.id_marca);
                $("#id_categoria").val(data.id_categoria);
                $('#modalProducto').modal('show');
                }
                else
                {
                    alert("Producto no encontrado.");
                }
            },
        error: function() {
                alert("Error al cargar el producto.");
            }
        });
        }

        $("#btnSaveProducto").click(function () {
            var producto = {
                id_producto: $("#id_producto").val(),
                producto: $("#producto").val(),
                costo: parseFloat($("#costo").val()),
                ganancia: parseFloat($("#ganancia").val()),
                id_marca: $("#id_marca").val(),
                id_categoria: $("#id_categoria").val()
            };

            $.ajax({
                url: "@Url.Action("Grabar", "Producto")",
            type: "POST",
            data: JSON.stringify(producto),
            contentType: "application/json",
            success: function(response) {
            if (response.resultado)
            {
                alert("Producto guardado con éxito.");
                $('#modalProducto').modal('hide');
                location.reload(); // Recargar la página o tabla
            }
            else
            {
                alert("Error al guardar el producto.");
            }
        },
        error: function() {
            alert("Error al guardar el producto.");
        }
        });
        });


        // Eliminar producto
        let productoAEliminar = "";

        window.Eliminar = function (id_producto) {
            productoAEliminar = id_producto;
            $("#modalEliminar").modal("show");
        };

        $("#btnEliminarConfirmado").click(function () {
            $.ajax({
                url: "@Url.Action("Borrar", "Producto")",
                type: "POST",
                data: JSON.stringify({ id_producto: productoAEliminar }),  // Usamos JSON.stringify para enviar los datos como JSON
                contentType: "application/json",  // Establecer el tipo de contenido como JSON
                success: function (data) {
                    if (data.resultado) {
                        // Recargar la tabla o realizar otras acciones
                        $("#tb_producto").DataTable().ajax.reload();
                        $("#modalEliminar").modal("hide");
                    } else {
                        alert("No se pudo eliminar el producto.");
                    }
                },
                error: function () {
                    alert("Error al eliminar el producto.");
                }
            });
        });
        });
    </script>
}
