@model app_compuware.Models.Departamento

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
    <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de Departamentos</h1>
<hr />

<div class="container">
    <div class="row mb-3">
    </div>

    <br />

    <div class="row">
        <table id="tb_departamento" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(dep => dep.id_departamento)</th>
                    <th>@Html.DisplayNameFor(dep => dep.departamento)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<div class="modal" tabindex="-1" id="modalDepartamento">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Nuevo Departamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formDepartamento" method="post">
                    <div class="mb-3">
                        <label for="id_departamento" class="form-label">ID Departamento</label>
                        <input type="text" class="form-control" asp-for="id_departamento" required maxlength="5">
                    </div>
                    <div class="mb-3">
                        <label for="departamento" class="form-label">Nombre Departamento</label>
                        <input type="text" class="form-control" asp-for="departamento" required maxlength="25">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSave">Guardar</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="ExportarPDF" class="btn btn-primary">
    <i class="fas fa-file-pdf"></i> Exportar PDF
</a>
<a asp-action="ExportarExcel" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
</a>

<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar este departamento?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#tb_departamento").DataTable({
                "ajax": {
                    "url": "@Url.Action("Listar", "Departamento")",
                    "type": "GET",
                    "dataType": "json"
                },
                "columns": [
                    { "data": "id_departamento" },
                    { "data": "departamento" },
                    {
                        "data": "id_departamento",
                        "render": function (data) {
                            return "<button class='btn btn-outline-success' type='button' onclick='AbrirRegistro(\"" + data + "\")'><i class='far fa-edit'></i> Editar</button>" +
                                "<button class='btn btn-outline-danger' type='button' onclick='Eliminar(\"" + data + "\")'><i class='far fa-trash-alt'></i> Borrar</button>";
                        }
                    }
                ],
                "order": [[1, "asc"]],
                dom: "Bfrtip",
                buttons: [
                    {
                        text: "Registrar Departamento",
                        attr: { class: "btn btn-outline-primary" },
                        action: function () {
                            AbrirRegistro("");
                        }
                    }
                ]
            });
        });

        function AbrirRegistro(id_departamento) {
            if (id_departamento != "") {
                jQuery.ajax({
                    url: "@Url.Action("Consultar", "Departamento")" + "?id_departamento=" + id_departamento,
                    type: "GET",
                    dataType: "json",
                    success: function (data) {
                        if (data != null) {
                            $("#id_departamento").val(data.id_departamento).attr("readonly", true);
                            $("#departamento").val(data.departamento);
                        }
                    }
                });

                $(".modal-title").text("Editar Departamento");
                $("#btnSave").html("<i class='fas fa-save'></i> Guardar cambios");

            } else {
                $("#id_departamento").attr("readonly", false);
                $("#id_departamento").val("");
                $("#departamento").val("");
                $(".modal-title").text("Registrar Departamento");
                $("#btnSave").html("<i class='fas fa-save'></i> Guardar datos");
            }
            $("#modalDepartamento").modal("show");
        }

        $("#btnSave").click(function () {
            let departamento = {
                "id_departamento": $("#id_departamento").val(),
                "departamento": $("#departamento").val()
            };

            $.ajax({
                url: "@Url.Action("Grabar", "Departamento")",
                type: "POST",
                data: JSON.stringify(departamento),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.resultado) {
                        $("#tb_departamento").DataTable().ajax.reload();
                        $("#modalDepartamento").modal("hide");
                    } else {
                        alert("No se pudo guardar la información.");
                    }
                },
                error: function () {
                    alert("Error al guardar la información.");
                }
            });
        });

        let departamentoAEliminar = "";

        function Eliminar(id_departamento) {
            departamentoAEliminar = id_departamento;
            $("#modalEliminar").modal("show");
        }

        $("#btnEliminarConfirmado").click(function () {
            $.ajax({
                url: "@Url.Action("Borrar", "Departamento")",
                type: "POST",
                data: { id_departamento: departamentoAEliminar },
                success: function (data) {
                    if (data.resultado) {
                        $("#tb_departamento").DataTable().ajax.reload();
                        $("#modalEliminar").modal("hide");
                    } else {
                        alert("No se pudo eliminar el departamento.");
                    }
                },
                error: function () {
                    alert("Error al eliminar el departamento.");
                }
            });
        });
    </script>
}