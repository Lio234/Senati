@model app_compuware.Models.Marca

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
    <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de las Marca</h1>
<hr/>
<div class="container">
    <div class="row mb-3">
        
    </div>
    

    <br />
    

    <div class="row">
        <table id="tb_marca" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(mar => mar.id_marca)</th>
                    <th>@Html.DisplayNameFor(mar => mar.marca)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


<div class="modal" tabindex="-1" id="modalMarca">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Nueva Marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formMarca" method="post">
                    <div class="mb-3">
                        <label for="id_marca" class="form-label">ID Marca</label>
                        <input type="text" class="form-control" asp-for="id_marca" required>
                    </div>
                    <div class="mb-3">
                        <label for="Marca" class="form-label">Nombre Marca</label>
                        <input type="text" class="form-control" asp-for="marca" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSave">Guardar</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="ExportarPDF" class="btn btn-primary">
    <i class="fas fa-file-pdf"></i> Exportar PDF
</a>

<a asp-action="ExportarExcel" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
</a>



<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar esta Marca?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
    <script>
        $(document).ready(function () {

            $("#tb_marca").DataTable({
                "ajax": {
                    "url": "@Url.Action("Listar", "Marca")",
                    "type": "GET",
                    "dataType": "json"
                },
                "columns": [
                    { "data": "id_marca" },
                    { "data": "marca" },
                    {
                        "data": "id_marca",
                        "render": function (data) {
                            return "<button class='btn btn-outline-success' type='button' onclick='AbrirRegistro(\"" + data + "\")'><i class='far fa-edit'></i> Editar</button>" +
                                "<button class='btn btn-outline-danger' type='button' onclick='Eliminar(\"" + data + "\")'><i class='far fa-trash-alt'></i> Borrar</button>";
                        }
                    }
                ],
                "order": [[1, "asc"]],
                dom: "Bfrtip",
                buttons: [
                    {
                        text: "Registrar Marca",
                        attr: { class: "btn btn-outline-primary" },
                        action: function () {
                            AbrirRegistro(""); 
                        }
                    }
                ]
            });
        });


        function AbrirRegistro(id_marca) {
            if (id_marca != "") {
                
                jQuery.ajax({
                    url: "@Url.Action("Consultar", "Marca")" + "?id_marca=" + id_marca,
                    type: "GET",
                    dataType: "json",
                    success: function (data) {
                        if (data != null) {
                            $("#id_marca").val(data.id_marca).attr("readonly", true);
                            $("#marca").val(data.marca);
                        }
                    }
                });

                $(".modal-title").text("Editar Marca");
                $("#btnSave").html("<i class='fas fa-save'></i> Guardar cambios");


            } else {

                $("#id_marca").attr("readonly", false);

                $("#id_marca").val("");
                $("#marca").val("");
                $(".modal-title").text("Registrar Marca");
                $("#btnSave").html("<i class='fas fa-save'></i> Guardar datos");


            }
            $("#modalMarca").modal("show");
        }

        
        $("#btnSave").click(function () {
            let marca = {
                "id_marca": $("#id_marca").val(),
                "marca": $("#marca").val()
            };

            $.ajax({
                url: "@Url.Action("Grabar", "Marca")",
                type: "POST",
                data: JSON.stringify(marca),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.resultado) {
                        $("#tb_marca").DataTable().ajax.reload();
                        $("#modalMarca").modal("hide");
                    } else {
                        alert("No se pudo guardar la información.");
                    }
                },
                error: function () {
                    alert("Error al guardar la información.");
                }
            });
        });


        let marcaAEliminar = "";

        function Eliminar(id_marca) {

            marcaAEliminar = id_marca;
            $("#modalEliminar").modal("show");
        }


        $("#btnEliminarConfirmado").click(function () {
            $.ajax({
                url: "@Url.Action("Borrar", "Marca")",
                type: "POST",
                data: { id_marca: marcaAEliminar },
                success: function (data) {
                    if (data.resultado) {
                        $("#tb_marca").DataTable().ajax.reload();
                        $("#modalEliminar").modal("hide");
                    } else {
                        alert("No se pudo eliminar la Marca.");
                    }
                },
                error: function () {
                    alert("Error al eliminar la Marca.");
                }
            });
        });
    </script>
}
