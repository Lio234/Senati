@model app_compuware.Models.Provincia

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section EstiloDT {
    <link rel="stylesheet" href="~/lib/datatable/css/jquery.dataTables.min.css" />
}

<h1>Listado de las Provincias</h1>
<hr />
<div class="container">
    <div class="row mb-3">
    </div>

    <br />

    <div class="row">
        <table id="tb_provincia" class="table table-bordered table-striped display" style="width: 100%;">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(prov => prov.id_provincia)</th>
                    <th>@Html.DisplayNameFor(prov => prov.provincia)</th>
                    <th>@Html.DisplayNameFor(prov => prov.id_departamento)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<div class="modal" tabindex="-1" id="modalProvincia">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Agregar Nueva Provincia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formProvincia" method="post">
                    <div class="mb-3">
                        <label for="id_provincia" class="form-label">ID Provincia</label>
                        <input type="text" class="form-control" id="id_provincia" required>
                    </div>
                    <div class="mb-3">
                        <label for="provincia" class="form-label">Nombre Provincia</label>
                        <input type="text" class="form-control" id="provincia" required>
                    </div>
                    <div class="mb-3">
                        <label for="id_departamento" class="form-label">Departamento</label>
                        <select id="id_departamento" class="form-control" required>
                            <option value="">Seleccione un departamento</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnSaveProvincia">Guardar</button>
            </div>
        </div>
    </div>
</div>


<a asp-action="ExportarPDF" class="btn btn-primary">
    <i class="fas fa-file-pdf"></i> Exportar PDF
</a>

<a asp-action="ExportarExcel" class="btn btn-success">
    <i class="fas fa-file-excel"></i> Exportar a Excel
</a>

<div class="modal" tabindex="-1" id="modalEliminar">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar esta Provincia?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-danger" id="btnEliminarConfirmado">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatable/js/jquery.dataTables.js"></script>
    <script src="~/lib/datatable/js/dataTables.buttons.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#tb_provincia").DataTable({
                "ajax": {
                    "url": "@Url.Action("Listar", "Provincia")",
                    "type": "GET",
                    "dataType": "json"
                },
                "columns": [
                    { "data": "id_provincia" },
                    { "data": "provincia" },
                    { "data": "id_departamento" },
                    {
                        "data": "id_provincia",
                        "render": function (data) {
                            return "<button class='btn btn-outline-success' type='button' onclick='AbrirRegistro(\"" + data + "\")'><i class='far fa-edit'></i> Editar</button>" +
                                "<button class='btn btn-outline-danger' type='button' onclick='Eliminar(\"" + data + "\")'><i class='far fa-trash-alt'></i> Borrar</button>";
                        }
                    }
                ],
                "order": [[1, "asc"]],
                dom: "Bfrtip",
                buttons: [
                    {
                        text: "Registrar Provincia",
                        attr: { class: "btn btn-outline-primary" },
                        action: function () {
                            AbrirRegistro("");
                        }
                    }
                ]
            });
        });

                function AbrirRegistro(id_provincia) {
            if (id_provincia !== "") {
            } else {
                $("#id_provincia").val("");
                $("#provincia").val("");
                $("#id_departamento").empty().append('<option value="">Seleccione un departamento</option>');

                $.ajax({
                    url: "@Url.Action("ListarDepartamentos", "Provincia")",
                    type: "GET",
                    dataType: "json",
                    success: function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (index, departamento) {
                                $("#id_departamento").append(
                                    `<option value="${departamento.id_departamento}">${departamento.departamento}</option>`
                                );
                            });
                        }
                    },
                    error: function () {
                        alert("Error al cargar los departamentos.");
                    }
                });
            }

            $(".modal-title").text(id_provincia ? "Editar Provincia" : "Agregar Provincia");
            $("#modalProvincia").modal("show");
        }


                $("#btnSaveProvincia").click(function () {
            let provincia = {
                "id_provincia": $("#id_provincia").val(),
                "provincia": $("#provincia").val(),
                "id_departamento": $("#id_departamento").val()
            };

            $.ajax({
                url: "@Url.Action("Grabar", "Provincia")",
                type: "POST",
                data: JSON.stringify(provincia),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.resultado) {
                        $("#tb_provincia").DataTable().ajax.reload();
                        $("#modalProvincia").modal("hide");
                    } else {
                        alert("No se pudo guardar la información.");
                    }
                },
                error: function () {
                    alert("Error al guardar la información.");
                }
            });
        });


        let provinciaAEliminar = "";

        function Eliminar(id_provincia) {
            provinciaAEliminar = id_provincia;
            $("#modalEliminar").modal("show");
        }

        $("#btnEliminarConfirmado").click(function () {
            $.ajax({
                url: "@Url.Action("Borrar", "Provincia")",
                type: "POST",
                data: { id_provincia: provinciaAEliminar },
                success: function (data) {
                    if (data.resultado) {
                        $("#tb_provincia").DataTable().ajax.reload();
                        $("#modalEliminar").modal("hide");
                    } else {
                        alert("No se pudo eliminar la Provincia.");
                    }
                },
                error: function () {
                    alert("Error al eliminar la Provincia.");
                }
            });
        });
    </script>
}

